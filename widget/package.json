    "test": "node --test --disable-warning=ExperimentalWarning \"src/lib/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}

  "components": {
    "schemas": {
      "uilab.session.AcceptProposal.Input": {
        "title": "Accept a proposal input",
        "x-ess-name": "uilab.session.AcceptProposal",
        "x-ess-kind": "command-input",
        "type": "object",
        "properties": {
          "proposal_id": {
            "$ref": "#/components/schemas/uilab.session.ProposalId"
          }
        },
        "required": [
          "proposal_id"
        ],
        "additionalProperties": false
      },
      "uilab.session.AcceptProposal.accepted.Response": {
        "additionalProperties": false,
        "description": "The patch is applied and the document is saved. Taken when no other outcome's condition matched. A `uilab.session.Proposal` has moved to `Accepted`, along `accept`. The instance is the one `proposal_id` names. Emits `ProposalAccepted`, published to consumers rather than returned here.",
        "properties": {
          "outcome": {
            "const": "accepted",
            "description": "Which declared outcome the command took."
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "uilab.session.AcceptProposal.stale.Response": {
        "additionalProperties": false,
        "description": "The proposal stays waiting and the document is unchanged. Decided outside the request: the document changed since the proposal and the patch no longer applies.",
        "properties": {
          "error": {
            "const": "uilab.session.PatchRefused",
            "description": "The patch fails a document check, so no proposal was made.",
            "type": "string"
          },
          "outcome": {
            "const": "stale",
            "description": "Which declared outcome the command took."
          },
          "payload": {
            "$ref": "#/components/schemas/uilab.session.PatchRefused.Error"
          }
        },
        "required": [
          "outcome",
          "error",
          "payload"
        ],
        "type": "object"
      },
      "uilab.session.AcceptProposal.wrong-state.Response": {
        "additionalProperties": false,
        "description": "The proposal is not waiting, so the document is unchanged. Taken when the subject is in a state none of this command's declared moves start from. Which states those are is the lifecycle's answer, not this command's. For an instance no record carries, `payload` is absent, because an instance that does not exist has nothing for the error to describe.",
        "properties": {
          "error": {
            "const": "uilab.session.ProposalStateConflict",
            "description": "The proposal is not in a state this command acts from, so nothing moved.",
            "type": "string"
          },
          "outcome": {
            "const": "wrong-state",
            "description": "Which declared outcome the command took."
          },
          "payload": {
            "$ref": "#/components/schemas/uilab.session.ProposalStateConflict.Error"
          }
        },
        "required": [
          "outcome",
          "error"
        ],
        "type": "object"
      },
